  * Start xkbcomp, let the callback write into xkbcomp's stdin. When done,
  * return a strdup'd copy of the file name we've written to.
  */
+/* The keymap callback cannot grow its input beyond this bound. */
+struct telorgon_xkb_input {
+    int fd;
+    size_t written;
+};
+
+static ssize_t
+telorgon_xkb_write(void *cookie, const char *bytes, size_t length)
+{
+    struct telorgon_xkb_input *input = cookie;
+    size_t done = 0;
+    if (length > 4 * 1024 * 1024 - input->written) {
+        errno = EFBIG;
+        return -1;
+    }
+    while (done < length) {
+        ssize_t n = write(input->fd, bytes + done, length - done);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0)
+            return -1;
+        done += n;
+    }
+    input->written += length;
+    return length;
+}
